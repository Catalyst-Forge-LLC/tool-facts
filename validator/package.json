{
  "name": "@xfacts/toolfacts",
  "version": "0.1.0",
  "description": "Validate TOOL_FACTS.md frontmatter against the ToolFacts JSON Schema.",
  "type": "module",
  "scripts": {
    "validate": "node bin/toolfacts.mjs validate",
    "typecheck": "tsc --noEmit",
    "encode-viewer": "node bin/toolfacts.mjs encode-viewer",
    "prepack": "node scripts/stage-schema.mjs tool-facts.schema.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.7"
    }
  },
  "license": "MIT",
  "bin": {
    "toolfacts": "./bin/toolfacts.mjs"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "scripts/stage-schema.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/tool-facts.git",
    "directory": "validator"
  },
  "publishConfig": {
    "access": "public"
  }
}
